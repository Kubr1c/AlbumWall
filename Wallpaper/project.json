      "transitionDirection": {
        "order": 5,
        "text": "动效 · 方向",
        "type": "combo",
        "value": "random",
        "options": [
          {
            "value": "horizontal",
            "label": "左右"
          },
          {
            "value": "vertical",
            "label": "上下"
          },
          {
            "value": "random",
            "label": "随机方向"
          }
        ]
